#!/usr/bin/make -f
%:
	dh $@

# Prebuilt Eclipse RCP distribution: only repackage it.
override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	mkdir -p debian/rodin/usr/lib/rodin
	tar --exclude=./debian --exclude=./.pc -cf - . \
	    | tar -C debian/rodin/usr/lib/rodin -xf -
	# Pin the Eclipse e4 CSS theme to the light default so the UI is not
	# rendered in a broken mixed light/dark theme on dark desktops.
	test -f debian/rodin/usr/lib/rodin/rodin.ini
	grep -q 'org.eclipse.e4.ui.css.swt.theme' debian/rodin/usr/lib/rodin/rodin.ini || \
	    printf '%s\n' '-Dorg.eclipse.e4.ui.css.swt.theme=org.eclipse.e4.ui.css.theme.e4_default' \
	        >> debian/rodin/usr/lib/rodin/rodin.ini
	# ProB's probcli.sh launcher chmods probcli and send_user_interrupt a+x
	# under set -e.  In this root-owned install that chmod fails for every
	# other user -- even though dh_fixperms below already sets the bits, they
	# do not own the files -- so ProB never starts.  Make the chmod
	# best-effort, and fail the build if upstream changed the script and the
	# patch no longer applies.
	set -e; for f in debian/rodin/usr/lib/rodin/plugins/de.prob.core_*/prob/linux64/probcli.sh; do \
	    test -f "$$f" || { echo "ProB's probcli.sh not found" >&2; exit 1; }; \
	    sed -i -e '/^[[:space:]]*chmod a+x /s|$$| 2>/dev/null \|\| :|' "$$f"; \
	    grep -q 'chmod a+x .* || :$$' "$$f" || { echo "probcli.sh patch did not apply" >&2; exit 1; }; \
	    if grep -E '^[[:space:]]*chmod a+x ' "$$f" | grep -qv ' || :$$'; then \
	        echo "unpatched chmod left in $$f" >&2; exit 1; \
	    fi; \
	done
	install -D -m0755 debian/rodin.wrapper debian/rodin/usr/bin/rodin
	install -D -m0644 icon.xpm debian/rodin/usr/share/pixmaps/rodin.xpm
	install -D -m0644 debian/rodin.desktop \
	    debian/rodin/usr/share/applications/rodin.desktop

# Normalize permissions: drop the execute bit from all files, then restore it
# for the Eclipse native launcher and any shell scripts (shared objects and
# data files stay 0644).
override_dh_fixperms:
	dh_fixperms
	find debian/rodin/usr/lib/rodin -type f -exec chmod 0644 {} +
	find debian/rodin/usr/lib/rodin -type f | while read -r f; do \
	    if head -c2 "$$f" 2>/dev/null | grep -q '#!'; then chmod 0755 "$$f"; continue; fi; \
	    case "$$(file -b "$$f")" in *ELF*executable*) chmod 0755 "$$f";; esac; \
	done

# Do not strip / compute library dependencies from the prebuilt binaries.
override_dh_strip:

override_dh_dwz:

override_dh_shlibdeps:

override_dh_makeshlibs:
