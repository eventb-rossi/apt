#!/usr/bin/make -f
# rossi is built from source with Cargo.  All crates are vendored into the orig
# tarball by get-orig.sh, so the build itself runs fully offline (cargo
# --frozen).  The Rust toolchain comes from the target series' archive (rustc and
# cargo are in Build-Depends, installed by Launchpad / sbuild): rossi's MSRV is
# 1.85 (Rust 2024 edition), first available in Ubuntu 25.10, so this package
# targets 26.04 LTS (resolute), not noble.  Nothing in the build relies on rustup.

export CARGO_HOME = $(CURDIR)/debian/cargo-home

%:
	dh $@

override_dh_auto_build:
	# Two-phase profile-guided optimization build, mirroring rossi's own release
	# workflow and the gentoo-overlay/fedora-copr rossi packages: build an
	# instrumented rossi, train it on the in-repo example models, merge the
	# resulting profile, then rebuild both binaries reading it back. The
	# instrument and profile-use cargo invocations must differ ONLY in that
	# RUSTFLAGS value -- any other difference changes rustc's -Cmetadata (baked
	# into the mangled symbols profiles are matched against) and PGO silently
	# stops applying. Unconditional (unlike gentoo-overlay's opt-in USE flag):
	# this package builds once, centrally, in a controlled chroot, so there's no
	# per-user build-time tradeoff to gate behind a flag. Older source tags
	# without scripts/pgo-train.sh fall back to a plain build -- version bumps
	# only ever touch debian/changelog (see scripts/version-check.py), never
	# this file, so it has to stay correct against whatever tag it's pointed at.
	if [ -x scripts/pgo-train.sh ] && [ -d crates/rossi/examples ]; then \
		llvm_ver=$$(rustc --version --verbose | sed -n 's/^LLVM version: \([0-9]*\).*/\1/p'); \
		profdata="llvm-profdata-$$llvm_ver"; \
		command -v "$$profdata" >/dev/null 2>&1 || { \
			echo "error: $$profdata not found; PGO needs the llvm Build-Depends" \
			     "to provide an llvm-profdata matching rustc's LLVM $$llvm_ver" >&2; \
			exit 1; \
		}; \
		pgodir="$(CURDIR)/target/pgo-profiles"; \
		rm -rf "$$pgodir"; \
		RUSTFLAGS="$${RUSTFLAGS:-} -Cprofile-generate=$$pgodir" \
			cargo build --release --frozen -p rossi-cli; \
		scripts/pgo-train.sh target/release/rossi; \
		"$$profdata" merge -o target/pgo-merged.profdata "$$pgodir"; \
		RUSTFLAGS="$${RUSTFLAGS:-} -Cprofile-use=$(CURDIR)/target/pgo-merged.profdata" \
			cargo build --release --frozen -p rossi-cli -p eventb-lsp; \
	else \
		echo "scripts/pgo-train.sh or crates/rossi/examples absent; building without PGO" >&2; \
		cargo build --release --frozen -p rossi-cli -p eventb-lsp; \
	fi

override_dh_auto_test:
	target/release/rossi --version
	target/release/eventb-language-server --version

override_dh_auto_install:
	install -D -m0755 target/release/rossi \
	    debian/rossi/usr/bin/rossi
	install -D -m0755 target/release/eventb-language-server \
	    debian/rossi/usr/bin/eventb-language-server
	# Shell completions, generated from the freshly-built binary (clap_complete)
	# so they can't drift from the actual CLI.  Installed to the canonical vendor
	# dirs; the files are inert without the shell/framework, so no extra Depends
	# are needed.  Only the rossi CLI has completions -- eventb-language-server is
	# a pure LSP server.  A non-zero exit here aborts the build rather than
	# shipping an empty completion file.
	install -d debian/rossi/usr/share/bash-completion/completions
	target/release/rossi completions bash \
	    > debian/rossi/usr/share/bash-completion/completions/rossi
	install -d debian/rossi/usr/share/zsh/vendor-completions
	target/release/rossi completions zsh \
	    > debian/rossi/usr/share/zsh/vendor-completions/_rossi
	install -d debian/rossi/usr/share/fish/vendor_completions.d
	target/release/rossi completions fish \
	    > debian/rossi/usr/share/fish/vendor_completions.d/rossi.fish

override_dh_auto_clean:
	rm -rf target debian/cargo-home

# dh_clean recursively deletes *.orig/*.rej/*.bak files; left to run over the
# vendored crates it strips files (e.g. Cargo.toml.orig) that Cargo's
# .cargo-checksum.json still references, breaking the offline build.  Keep it
# away from vendor/.
override_dh_clean:
	dh_clean -Xvendor

# Rust release binaries carry no separate debug info; dwz errors on them.
override_dh_dwz:
